# --- docker compose ---
POSTGRES_PASSWORD=change-me
S3_ACCESS_KEY=forgesight
S3_SECRET_KEY=change-me-too-min-8-chars
FS_SECRET_KEY=generate-with:  python -c "import secrets; print(secrets.token_urlsafe(48))"
FS_ADMIN_EMAIL=admin@forgesight.local
FS_ADMIN_PASSWORD=change-me-at-least-10-chars
FS_CORS_ORIGINS=http://localhost:3000

# --- backend (all optional; defaults in backend/app/config.py) ---
# FS_DATABASE_URL=postgresql+psycopg://forgesight:forgesight@localhost:5432/forgesight
# FS_STORAGE_BACKEND=local            # local | s3
# FS_STORAGE_DIR=./data/storage
# FS_S3_ENDPOINT_URL= FS_S3_BUCKET= FS_S3_REGION= FS_S3_ACCESS_KEY= FS_S3_SECRET_KEY=
# FS_MODELS_DIR=./data/models
# FS_WEIGHTS_DIR=./data/weights
# FS_DEVICE=cuda                      # force device; default auto (cuda > mps > cpu)
# FS_ACCESS_TOKEN_MINUTES=480
# FS_MAX_UPLOAD_MB=25  FS_MAX_VIDEO_MB=300  FS_JOB_WORKERS=2

# --- frontend ---
# BACKEND_URL=http://127.0.0.1:8000   # where Next.js proxies /api
